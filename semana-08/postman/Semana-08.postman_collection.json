        },
        {
          "name": "Completar tarea creada",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/tasks/{{createdTaskId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{anaToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"done\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar tarea creada",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/tasks/{{createdTaskId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{anaToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "La tarea ya no existe",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tasks/{{createdTaskId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{anaToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - CORS: inspección de cabeceras (diapositivas 11-12)",
      "item": [
        {
          "name": "Preflight público con Authorization",
          "request": {
            "method": "OPTIONS",
            "url": "{{baseUrl}}/tasks",
            "header": [
              {
                "key": "Origin",
                "value": "http://localhost:5173"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "GET"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "authorization"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
                  "pm.test(\"Origen permitido\", () => { if (pm.response.headers.get(\"access-control-allow-origin\") !== \"http://localhost:5173\") throw new Error(\"Falta CORS\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Origen ajeno: Postman NO aplica el bloqueo del navegador",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "header": [
              {
                "key": "Origin",
                "value": "http://localhost:5174"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Sin permiso de lectura CORS\", () => { if (pm.response.headers.get(\"access-control-allow-origin\")) throw new Error(\"Origen no debería estar autorizado\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Registro, login y Zod (diapositivas 13-21)",
      "item": [
        {
          "name": "Registrar usuario ficticio",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"RegistroSeguro8!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"registerEmail\", \"registro.\" + Date.now() + \"@example.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Solo id/email\", () => { if (Object.keys(pm.response.json()).sort().join(\",\") !== \"email,id\") throw new Error(\"Contrato incorrecto\"); });"
                ]
