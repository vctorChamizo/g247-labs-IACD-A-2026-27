{
  "info": {
    "name": "Semana 08 - Autenticación y seguridad",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar los bloques en orden sobre la DB de demostración. Contraseñas ficticias del seed; no importar credenciales reales."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "anaToken",
      "value": ""
    },
    {
      "key": "luisToken",
      "value": ""
    },
    {
      "key": "anaTaskId",
      "value": ""
    },
    {
      "key": "luisTaskId",
      "value": ""
    },
    {
      "key": "createdTaskId",
      "value": ""
    },
    {
      "key": "registerEmail",
      "value": ""
    },
    {
      "key": "tamperedToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Identidad y autenticación (diapositivas 2-9)",
      "item": [
        {
          "name": "API viva",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Base preparada",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health/db",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sin token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tasks",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Ana",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana@example.com\",\n  \"password\": \"AulaSegura8!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"anaToken\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Luis",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"luis@example.com\",\n  \"password\": \"AulaSegura8!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"luisToken\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Token manipulado",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tasks",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tamperedToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const parts = pm.collectionVariables.get(\"anaToken\").split(\".\");",
                  "parts[2] = (parts[2][0] === \"a\" ? \"b\" : \"a\") + parts[2].slice(1);",
                  "pm.collectionVariables.set(\"tamperedToken\", parts.join(\".\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Propiedad y CRUD (diapositiva 10)",
      "item": [
        {
          "name": "Tareas de Ana",
          "request": {
            "method": "GET",
