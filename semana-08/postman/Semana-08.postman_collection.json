        {
          "name": "Límites seguros",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tasks?page=0&limit=999",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{anaToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"page=1 y limit=100\", () => { const r=pm.response.json(); if(r.page!==1 || r.limit!==100) throw new Error(\"Normalización incorrecta\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Fracción: usar default, no truncar",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tasks?page=2.7&limit=2",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{anaToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Fracción usa página por defecto\", () => { if(pm.response.json().page!==1) throw new Error(\"No debería truncar\"); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
