        },
        {
          "name": "Propietario inyectado en el body",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/tasks",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{anaToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Suplantación\",\n  \"done\": false,\n  \"userId\": 2147483647\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear como Ana",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/tasks",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{anaToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Tarea de prueba de clase\",\n  \"done\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"createdTaskId\", String(pm.response.json().id));",
                  "pm.test(\"No expone seed_key\", () => { if (\"seed_key\" in pm.response.json()) throw new Error(\"Campo interno expuesto\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Reemplazar tarea creada",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/tasks/{{createdTaskId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{anaToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Tarea reemplazada\",\n  \"done\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
